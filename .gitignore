# ==============================================================================
# Project Warden: warden-cache-redis (.gitignore)
# Excludes non-program files, documentation, temporary artifacts, and secrets
# ==============================================================================

# --- Documentation & Specification Files ---
Docs/
docs/
*.md
!README.md
AGENTS.md
*.pdf
*.docx
*.rtf
*.txt
!requirements*.txt

# --- Agent & Session Metadata ---
.agent/
.agents/
.superpowers/
.opencode/
opencode.json
AGENTS.md

# --- Build Artifacts & Virtual Environments ---
Build/
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/

# --- Node.js & Tooling Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# --- Python Bytecode & Runtime Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Testing & Quality Assurance Tool Caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.cache/
.tox/
.nox/

# --- Secrets, Credentials & Local Environment Files ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
*.pfx
secrets/
*.secret

# --- OS & Editor Generated Files ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# --- Logs & Runtime Output ---
*.log
logs/
tmp/
temp/
